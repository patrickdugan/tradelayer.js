{
  "name": "tradelayer",
  "version": "1.0.0",
  "description": ".js rebuild of TradeLayer protocol",
  "main": "main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:channel-contract-fuzz": "node tests/channelContractTradeFuzz.js",
    "test:tx-type-coverage": "node tests/txTypeCoverageAudit.js",
    "test:options": "jest tests/optionsFeature.test.js tests/optionsMarginValidation.test.js tests/optionsClearing.test.js --runInBand",
    "test:options-live": "node tests/optionsLiveIntegration.js",
    "test:options-forced-assignment-live": "node tests/optionsForcedAssignmentLive.js",
    "test:options-amm-liq-live": "node tests/optionsAmmLiqLive.js",
    "test:send-vest-live": "node tests/sendVestTest.js",
    "test:amm-contract-live": "node tests/ammContractLive.js",
    "test:amm-contract-taker-live": "node tests/ammContractTakerLive.js",
    "test:scaling-settlement-live": "node tests/scalingSettlementLive.js",
    "test:dlc-scenario": "node tests/dlcMultiDepositorScenario.js",
    "test:dlc-live": "node tests/dlcLiveIntegration.js",
    "test:dlc-daily-short-epoch-live": "node tests/dlcDailyShortEpochBundleLive.js",
    "test:bitvm-plan-a-live": "node tests/tx30BitvmPlanALive.js",
    "test:bitvm-plan-a-live:uphold": "node tests/tx30BitvmPlanAMatrix.js --verdict uphold",
    "test:bitvm-plan-a-live:reject": "node tests/tx30BitvmPlanAMatrix.js --verdict reject",
    "test:bitvm-plan-a-live:both": "node tests/tx30BitvmPlanAMatrix.js --both",
    "test:bitvm-watchtower-live": "node tests/bitvmWatchtowerLive.js",
    "setup:testnet-activations": "node scripts/setupTestnetActivationSet.js --mode=local-db",
    "setup:testnet-activations:print": "node scripts/setupTestnetActivationSet.js --mode=print",
    "test:testnet-activation-profile": "jest tests/testnetActivationProfile.test.js --runInBand",
    "check:btctest-consensus": "node scripts/checkBtctestConsensus.js",
    "test:zk-batch": "jest tests/zkBatchMovementDraft.test.js --runInBand",
    "wasm:check": "cargo check --manifest-path wasm/tlzk_verifier/Cargo.toml",
    "wasm:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path wasm/tlzk_verifier/Cargo.toml",
    "wasm:bindgen:node": "wasm-bindgen --target nodejs --out-dir wasm/tlzk_verifier/pkg-node wasm/tlzk_verifier/target/wasm32-unknown-unknown/release/tlzk_verifier.wasm",
    "wasm:bindgen:web": "wasm-bindgen --target web --out-dir wasm/tlzk_verifier/pkg wasm/tlzk_verifier/target/wasm32-unknown-unknown/release/tlzk_verifier.wasm",
    "wasm:bundle": "npm run wasm:build && npm run wasm:bindgen:node && npm run wasm:bindgen:web",
    "zk:channel-transfer:sign": "node scripts/signZkChannelTransferPath.js",
    "zk:channel-transfer:build": "node scripts/buildZkSignedChannelTransferDemo.js",
    "zk:channel-transfer:prove:snacksack": "powershell -NoProfile -ExecutionPolicy Bypass -File C:\\projects\\TLZK\\scripts\\prove_snacksack.ps1 -Batch artifacts\\zk_signed_channel_transfer\\signed_channel_transfer_batch_latest.json -StwoProverScript C:\\projects\\TLZK\\scripts\\tlzk_stwo_batch_prover.sh",
    "zk:channel-transfer:live": "node scripts/runZkSignedChannelTransferLive.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "oldTests1"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickdugan/tradelayer.js.git"
  },
  "author": "Patrick Dugan",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/patrickdugan/tradelayer.js/issues"
  },
  "resolutions": {
    "underscore": "^1.13.1",
    "binary-search-tree": "latest"
  },
  "homepage": "https://github.com/patrickdugan/tradelayer.js#readme",
  "dependencies": {
    "abstract-level": "^1.0.3",
    "axios": "^1.7.7",
    "big-json": "^3.2.0",
    "bigint-base-converter": "0.1.3",
    "bignumber.js": "^9.1.2",
    "bip32": "^5.0.0",
    "bitcoin": "3.0.3",
    "bitcoinjs-lib": "^6.1.7",
    "bitcore-lib": "^8.22.1",
    "bitcore-lib-doge": "^10.7.0",
    "bitcore-lib-ltc": "^10.0.21",
    "child_process": "^1.0.2",
    "dogecoind-rpc": "0.8.1",
    "ecpair": "*",
    "express": "^4.18.2",
    "level": "^8.0.0",
    "level-sublevel": "^6.1.1",
    "litecoin": "^2.0.5",
    "litecore-lib": "^0.13.22",
    "math.js": "^1.1.46",
    "mathjs": "^14.6.0",
    "nedb": "^1.8.0",
    "node-fetch": "^2.7.0",
    "redis": "^4.6.11",
    "tiny-secp256k1": "^2.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
